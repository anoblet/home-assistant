# Block by default
*

# Include
!**/*.yaml
!.copilot
!.copilot/**
!.github
!.github/**/*
!.gitignore
!.gitmodules
!.husky/**/*
!.prettierignore
!.prettierrc
!.vscode
!.vscode/**/*
!awesome-copilot
!awesome-copilot/**/*
!bin
!bin/**
!copilot
!copilot/**
!docs
!docs/**
!genaisrc
!genaisrc/**/*
!includes
!includes/**/*
!link.json
!memory
!memory/**
!package.json
!package-lock.json
!packages
!packages/**/*
!README.md
!reports
!reports/**
!www/custom/**/*
!www/custom-elements/**/*

# Exclude
esphome/secrets.yaml
go2rtc.yaml
known_devices.yaml
node_modules
secrets.yaml
www/custom-elements/build
zigbee2mqtt/configuration_*
zigbee2mqtt/coordinator_backup.json
zigbee2mqtt/secrets.yaml

# VeSync
!custom_components
!custom_components/vesync
!custom_components/vesync/**

# Never commit Python bytecode/cache (allowlist repo needs explicit blocks).
custom_components/vesync/**/__pycache__/
custom_components/vesync/**/*.pyc

# Always block
.env
secrets.yaml
