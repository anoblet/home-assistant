# Block by default
*

# Include
!**/*.yaml
!.github
!.github/**/*
!.agents
!.agents/**/*
!.gitignore
!.gitmodules
!.husky/**/*
!.prettierignore
!.prettierrc
!.vscode
!.vscode/**/*
!awesome-copilot
!awesome-copilot/**/*
!bin
!bin/**
!copilot
!copilot/**
!docs
!docs/**
!esphome
!esphome/**
!genaisrc
!genaisrc/**/*
!includes
!includes/**/*
!link.json
!memory
!memory/**
!package.json
!package-lock.json
!packages
!packages/**/*
!reports
!reports/**
!scripts
!scripts/**
!www/custom/**/*
!www/custom-elements/**/*

!CHANGELOG.md
!README.md

# Exclude
esphome/secrets.yaml
go2rtc.yaml
known_devices.yaml
node_modules
secrets.yaml
www/custom-elements/build
zigbee2mqtt/configuration_*
zigbee2mqtt/coordinator_backup.json
zigbee2mqtt/devices.yaml
zigbee2mqtt/secrets.yaml

# Never commit Python bytecode/cache (allowlist repo needs explicit blocks).
custom_components/vesync/**/__pycache__/
custom_components/vesync/**/*.pyc

scripts/**/__pycache__/
scripts/**/*.pyc

# Always block
.env
secrets.yaml

# CLI build outputs (this repo is allowlist-based; add explicit blocks)
bin/cli/dist/

!AGENTS.md
