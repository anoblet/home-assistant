{
  "name": "cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Home Assistant REST API TypeScript client and CLI",
  "keywords": [
    "home-assistant",
    "cli",
    "rest",
    "api"
  ],
  "main": "src/index.ts",
  "bin": {
    "home-assistant": "bin/home-assistant.cjs"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "home-assistant": "node bin/home-assistant.cjs",
    "dev": "node bin/home-assistant.cjs",
    "smoke": "node --no-warnings --experimental-strip-types src/smoke.ts",
    "test": "node --no-warnings --test --experimental-strip-types src/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "pnpm run typecheck"
  },
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.20.0",
  "dependencies": {
    "commander": "^11.0.0",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.3",
    "typescript": "^5.6.3"
  }
}
