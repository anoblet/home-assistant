{
  "home-assistant-monitoring": {
    "description": "Read CPU statistics and ath10k temperature for Home Assistant",
    "read": {
      "ubus": {
        "file": ["read", "list"]
      },
      "file": {
        "/proc/stat": ["read"],
        "/sys/class/hwmon/hwmon0/name": ["read"],
        "/sys/class/hwmon/hwmon0/temp1_input": ["read"],
        "/sys/devices/pci0000:00/0000:00:00.0/hwmon/hwmon0/name": ["read"],
        "/sys/devices/pci0000:00/0000:00:00.0/hwmon/hwmon0/temp1_input": ["read"]
      }
    }
  }
}
